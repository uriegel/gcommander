<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name progresscontrol.ui -->
  <requires lib="gtk" version="4.18"/>
  <object class="GtkRevealer" id="progressRevealer">
    <property name="transition-type">slide-left</property>
    <child>
      <object class="GtkMenuButton" id="progressControl">
        <property name="popover">
          <object class="GtkPopover">
            <child>
              <object class="GtkBox">
                <property name="margin-bottom">20</property>
                <property name="margin-end">20</property>
                <property name="margin-start">20</property>
                <property name="margin-top">20</property>
                <property name="orientation">vertical</property>
                <property name="spacing">20</property>
                <property name="width-request">400</property>
                <child>
                  <object class="GtkBox">
                    <property name="halign">start</property>
                    <child>
                      <object class="GtkLabel" id="titleLabel">
                        <property name="css-classes">title-3</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="sizeLabel">
                        <property name="css-classes">title-3</property>
                        <property name="margin-start">10</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid">
                    <property name="halign">fill</property>
                    <child>
                      <object class="GtkLabel" id="currentNameLabel">
                        <property name="halign">start</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="currentCountLabel">
                        <property name="halign">end</property>
                        <property name="hexpand">true</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="halign">end</property>
                        <property name="label">/</property>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="totalCountLabel">
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">3</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="halign">start</property>
                        <property name="label">Dauer: </property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="halign">start</property>
                        <property name="label">Geschätzte Restzeit: </property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="durationLabel">
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="column-span">3</property>
                          <property name="row">1</property>
                          <property name="row-span">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="estimatedDurationLabel">
                        <property name="halign">end</property>
                        <layout>
                          <property name="column">1</property>
                          <property name="column-span">3</property>
                          <property name="row">2</property>
                          <property name="row-span">1</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkProgressBar" id="progressbarCurrent">
                    <property name="show-text">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="halign">start</property>
                        <property name="label">Gesamt:</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkProgressBar" id="progressbarTotal">
                        <property name="show-text">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="cancelBtn">
                    <property name="label">Abbrechen</property>
                    <style>
                      <class name="destructive-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
        <child>
          <object class="GtkDrawingArea" id="progressSpinner"/>
        </child>
      </object>
    </child>
  </object>
</interface>

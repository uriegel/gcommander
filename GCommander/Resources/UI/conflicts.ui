<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name dialog.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.6"/>
  <object class="AdwAlertDialog" id="dialog">
    <property name="close-response">cancel</property>
    <property name="content-height">600</property>
    <property name="content-width">800</property>
    <property name="default-response">ok</property>
    <property name="focus-widget">name</property>
    <property name="prefer-wide-layout">True</property>
    <child>
      <object class="GtkBox" id="conflictBox">
        <child>
          <object class="GtkEntry" id="name">
            <property name="activates-default">True</property>
            <property name="halign">center</property>
            <property name="height-request">0</property>
            <property name="hexpand">True</property>
            <property name="valign">center</property>
            <property name="width-request">0</property>
          </object>
        </child>
      </object>
    </child>
    <!-- Custom object fragments -->
    <responses>
      <response id="cancel" translatable="yes">_Abbrechen</response>
      <response id="ok" translatable="yes" appearance="suggested">_OK</response>
    </responses>
  </object>
</interface>

<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name dialog.ui -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.6"/>
  <object class="AdwAlertDialog" id="dialog">
    <property name="body">Möchtest du das externe Gerät hinzufügen?</property>
    <property name="close-response">cancel</property>
    <property name="default-response">ok</property>
    <property name="focus-widget">name</property>
    <property name="heading">Externes Gerät</property>
    <property name="prefer-wide-layout">True</property>
    <child>
      <object class="GtkGrid">
        <property name="column-spacing">5</property>
        <property name="row-spacing">10</property>
        <child>
          <object class="GtkLabel">
            <property name="halign">start</property>
            <property name="label">Name</property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">1</property>
              <property name="row">0</property>
              <property name="row-span">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="halign">start</property>
            <property name="label">IP-Adresse</property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">1</property>
              <property name="row">1</property>
              <property name="row-span">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="name">
            <property name="activates-default">True</property>
            <property name="hexpand">True</property>
            <layout>
              <property name="column">1</property>
              <property name="column-span">1</property>
              <property name="row">0</property>
              <property name="row-span">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="ip">
            <property name="activates-default">True</property>
            <property name="hexpand">True</property>
            <layout>
              <property name="column">1</property>
              <property name="column-span">1</property>
              <property name="row">1</property>
              <property name="row-span">1</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="android">
            <property name="label">Android-Gerät</property>
            <layout>
              <property name="column">0</property>
              <property name="column-span">2</property>
              <property name="row">2</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <!-- Custom object fragments -->
    <responses>
      <response id="cancel" translatable="yes">_Abbrechen</response>
      <response id="ok" translatable="yes" appearance="suggested">_OK</response>
    </responses>
  </object>
</interface>
